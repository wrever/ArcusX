# ═══════════════════════════════════════════════════════════════════
# Escrow nativo — variables de entorno (PREPARACIÓN — sin deploy aún)
# ═══════════════════════════════════════════════════════════════════

# ── UN SOLO SWITCH DE RED (frontend ArcusX — ya existente) ─────────
# testnet (default) | mainnet
VITE_STELLAR_NETWORK=testnet

# Trustless Work API (misma red que Stellar — OBLIGATORIO alinear):
# testnet → development  |  mainnet → mainnet
VITE_TRUSTLESS_WORK_BASE_URL=development

# Wallets públicas (G...)
VITE_PLATFORM_WALLET=
VITE_ADMIN_WALLET=

# Supabase (cliente)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Escrow nativo en app (Fase 6) — false = solo Trustless Work
VITE_ESCROW_NATIVE_ENABLED=false

# ── Edge Functions (Supabase Dashboard → Secrets) ─────────────────
# Debe coincidir con VITE_STELLAR_NETWORK
STELLAR_NETWORK=testnet

# Soroban — roles en contrato (mismas que VITE_*)
PLATFORM_WALLET=
ADMIN_WALLET=

# Fase S1: API Trustless Work para XDR deploy/fund (mismo contrato C…)
TRUSTLESS_WORK_API_KEY=
# TRUSTLESS_WORK_API_URL=https://dev.api.trustlesswork.com

# Obsoleto en flujo Soroban (solo legacy G…):
# ARCUSX_PLATFORM_SECRET=
# ESCROW_SECRET_ENCRYPTION_KEY=

# Opcional: override fees sin migración SQL (bps)
# CLIENT_FEE_BPS=150
# FREELANCER_FEE_BPS=150

# Flag global (también en arcusx_system_config) — true solo al hacer switch TW→WASM
# ESCROW_NATIVE_ENABLED=false

# Backend Edge: tw (default prod) | native_wasm (prep testnet)
# ESCROW_BACKEND=tw

# Hash WASM desplegado (Soroban) — obligatorio con native_wasm
# ARCUSX_ESCROW_WASM_HASH=

# Admin panel (Edge)
# ESCROW_ADMIN_USER_IDS=uuid1,uuid2
# ESCROW_CORS_ORIGINS=https://arcusx.pro,http://localhost:5173
# ARCUSX_ADMIN_WALLETS=GADMIN...
# ESCROW_ENFORCE_TASK_MEMBERSHIP=true
