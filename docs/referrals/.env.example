# Supabase (PHP + Edge)
ARCUSX_SUPABASE_URL=https://your-project.supabase.co
ARCUSX_SUPABASE_SERVICE_ROLE_KEY=

# Referidos — mismo secret en PHP y Edge
REFERRAL_INTERNAL_SECRET=generate-long-random-string
REFERRAL_HASH_SALT=another-random-salt

# Notificar admins en arcusx_notifications (IDs MySQL, separados por coma)
REFERRAL_ADMIN_MYSQL_IDS=1

# Edge opcional
REFERRAL_CORS_ORIGINS=https://arcusx.pro,http://localhost:5173
