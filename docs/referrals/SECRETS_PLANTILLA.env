# Referidos — fuente recomendada: arcusx/.env (bloque sin VITE_)
#
# 1. Supabase Edge Secrets  ← ya lo subiste
# 2. arcusx/.env            ← copia de trabajo local
# 3. Hosting PHP            ← mismos ARCUSX_* y REFERRAL_* (SetEnv / .env del servidor)
#
# NO uses prefijo VITE_ en secrets (se filtrarían al build del frontend).

# --- Pegar en arcusx/.env y en Supabase Edge (los que ya subiste) ---

ARCUSX_SUPABASE_URL=https://atgsesbstjleabesclzs.supabase.co
# cPanel: mínimo ANON para login OAuth; SERVICE_ROLE para referidos vía PHP
ARCUSX_SUPABASE_ANON_KEY=<Dashboard → Settings → API → anon public>
ARCUSX_SUPABASE_SERVICE_ROLE_KEY=<Dashboard → Settings → API → service_role>

REFERRAL_INTERNAL_SECRET=<mismo en Edge y PHP>
REFERRAL_HASH_SALT=<mismo en Edge y PHP>
REFERRAL_ADMIN_MYSQL_IDS=1

# Solo Edge:
REFERRAL_CORS_ORIGINS=https://arcusx.pro,https://www.arcusx.pro,http://localhost:5173
ARCUSX_JWT_SECRET=<mismo que ARCUSX_JWT_SECRET del backend PHP>

# PHP no lee arcusx/.env en producción — hay que definir las mismas vars en el servidor.
