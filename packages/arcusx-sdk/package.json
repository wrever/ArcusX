{
  "name": "@arcusx/sdk",
  "version": "0.5.1",
  "description": "TypeScript SDK for ArcusX Work Execution Layer (Stellar USDC escrow + task lifecycle)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "smoke": "npm run build && node ../../scripts/smoke-sdk.mjs",
    "smoke:strict": "npm run build && SMOKE_STRICT=1 node ../../scripts/smoke-sdk.mjs",
    "smoke:agentic": "npm run build && node ../../scripts/smoke-agentic.mjs",
    "smoke:sow3:week1": "npm run build && node ../../scripts/smoke-sow3-week1.mjs",
    "demo:sow3:week1": "npm run build && node ../../scripts/demo-sow3-week1.mjs",
    "smoke:sow3:week2": "npm run build && node ../../scripts/smoke-sow3-week2.mjs",
    "demo:sow3:week2": "npm run build && node ../../scripts/demo-sow3-week2.mjs",
    "smoke:sow3:week3": "npm run build && node ../../scripts/smoke-sow3-week3.mjs",
    "demo:sow3:week3": "npm run build && node ../../scripts/demo-sow3-week3.mjs",
    "demo:week1": "npm run build && node ../../scripts/demo-week1-sdk.mjs",
    "demo:week2": "npm run build && node ../../scripts/demo-week2-award.mjs",
    "demo:week3": "npm run build && node ../../scripts/demo-week3-escrow.mjs",
    "demo:week4": "npm run build && node ../../scripts/demo-week4-release.mjs",
    "demo:agentic": "npm run build && node ../../scripts/demo-agentic-week1.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "arcusx",
    "stellar",
    "usdc",
    "escrow",
    "freelance"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@stellar/stellar-sdk": ">=11.0.0"
  },
  "peerDependenciesMeta": {
    "@stellar/stellar-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^11.3.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
