{
  "name": "@arcusx/sdk",
  "version": "0.4.5",
  "description": "TypeScript SDK for ArcusX Work Execution Layer (Stellar USDC escrow + task lifecycle)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "smoke": "npm run build && node ../../scripts/smoke-sdk.mjs",
    "smoke:strict": "npm run build && SMOKE_STRICT=1 node ../../scripts/smoke-sdk.mjs",
    "smoke:agentic": "npm run build && node ../../scripts/smoke-agentic.mjs",
    "demo:week1": "npm run build && node ../../scripts/demo-week1-sdk.mjs",
    "demo:agentic": "npm run build && node ../../scripts/demo-agentic-week1.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["arcusx", "stellar", "usdc", "escrow", "freelance"],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
