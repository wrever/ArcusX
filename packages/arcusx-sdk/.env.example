# Copy to your app .env — never commit real keys.
# Generate sandbox key: scripts/generate-partner-key.mjs (service role)
# or Dashboard → Developer → API keys.

# Required for partner / gateway path (SOW 2 + SOW 3)
ARCUSX_API_KEY=axk_test_your_sandbox_key_here

# Optional — default is https://api.arcusx.pro
# ARCUSX_API_URL=https://api.arcusx.pro

# Optional — SOW 3 agentic create (Stellar G… payer wallet)
# AGENTIC_PAYER_WALLET=

# Optional — user-scoped marketplace actions
# ARCUSX_USER_JWT=

# Internal only (Edge direct). Partners do NOT need these when using api.arcusx.pro
# ARCUSX_API_URL=https://YOUR_PROJECT.supabase.co/functions/v1/arcusx-api
# SUPABASE_ANON_KEY=eyJ…
