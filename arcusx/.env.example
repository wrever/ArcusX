# ============================================
# REFERIDOS + PHP / EDGE (NO usar prefijo VITE_)
# NO se incluyen en npm run build. El navegador nunca las ve.
# Copia estos valores al .htaccess del servidor (SetEnv), igual que DB/JWT.
# Ver backend_externo/.htaccess
# ============================================
ARCUSX_SUPABASE_URL=https://example.supabase.co
ARCUSX_SUPABASE_SERVICE_ROLE_KEY=
REFERRAL_INTERNAL_SECRET=
REFERRAL_HASH_SALT=
REFERRAL_ADMIN_MYSQL_IDS=1
# Solo Edge (opcional; ya en Supabase Secrets):
# REFERRAL_CORS_ORIGINS=https://arcusx.pro,https://www.arcusx.pro,http://localhost:5173
# ARCUSX_JWT_SECRET=  # mismo que backend ARCUSX_JWT_SECRET (referral-admin)


VITE_TRUSTLESS_WORK_API_KEY=
VITE_TRUSTLESS_WORK_BASE_URL=development
VITE_PLATFORM_WALLET=
VITE_ADMIN_WALLET=


VITE_STELLAR_NETWORK=testnet


VITE_SOROSWAP_API_BASE=https://api.soroswap.finance
