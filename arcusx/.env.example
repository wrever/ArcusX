# =============================================================================
# Variables de entorno - ArcusX (Vite)
# =============================================================================
# Copia este archivo a .env y rellena los valores. No subas .env a git.
# En producción: configúralas antes de "npm run build" o usa .env.production
# =============================================================================

# --- Backend API (login/registro manual, tareas, etc.) ---
VITE_API_URL=https://arcusx.pro/api

# --- Supabase (login con Google/GitHub) ---
# Dónde sacarlas: https://supabase.com/dashboard → tu proyecto → Project Settings → API
#   - Project URL → VITE_SUPABASE_URL
#   - anon / public key → VITE_SUPABASE_ANON_KEY (no uses la service_role en el front)
# En Authentication → URL Configuration añade Redirect URL: https://arcusx.pro/auth/callback
VITE_SUPABASE_URL=https://atgsesbstjleabesclzs.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- API de escrow (integración interna) ---
# VITE_TRUSTLESS_WORK_API_KEY=
# VITE_TRUSTLESS_WORK_BASE_URL=development
# VITE_PLATFORM_WALLET=
# VITE_ADMIN_WALLET=

# --- Stellar / red ---
# VITE_STELLAR_NETWORK=testnet

# --- Soroswap (swap) ---
# VITE_SOROSWAP_API_BASE=https://api.soroswap.finance
# VITE_SOROSWAP_API_KEY=

# --- Subdominio / portal corporativo (empresas.arcusx.pro) ---
# Mismo build: subís el mismo dist/ a arcusx.pro y empresas.arcusx.pro (detección por hostname en runtime).
# Sitio público (enlaces "ArcusX público", legal): https://arcusx.pro
# VITE_MAIN_SITE_URL=https://arcusx.pro
# URL exacta del botón "Entrar al portal" (login). Vacío = mismo origen + /login en host empresas.*
# VITE_ENTERPRISE_APP_URL=https://empresas.arcusx.pro/login
# Forzar landing B2B en / sin depender del hostname (dev): true | false
# VITE_ENTERPRISE_LANDING_HOST=false
# URL base de la landing B2B (página "Empresas" en elegir portal). Vacío = https://empresas.arcusx.pro
# VITE_ENTERPRISE_LANDING_URL=https://empresas.arcusx.pro
