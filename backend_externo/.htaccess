# ArcusX SPA (Vite/React) — copiar este archivo a la raíz de public_html Y a la raíz del subdominio (mismo dist/).
# Si ves 404 en empresas.*: en cPanel → Subdominios → comprobar que la carpeta contiene index.html, assets/ y este .htaccess
#
# secretos backend (solo en servidor; editar estos valores en cPanel/File Manager, NO subirlos al repo público).
# Requiere mod_env. Si getenv() sigue vacío, el host puede usar PHP-FPM sin pasar vars: usa entorno desde cPanel o contacta soporte.

<IfModule mod_env.c>
  # MySQL + JWT app (ya los tienes en producción)
  SetEnv ARCUSX_DB_PASSWORD "Brn08a33!"
  SetEnv ARCUSX_JWT_SECRET "GA7UTLCKIPSQSCRLILQKZGE24X5CBAH32C7NJEZ2NKQLTB4OZDINXL3D"

  # OAuth sync (sync_supabase_user.php) — NO van en arcusx/.env del build
  SetEnv ARCUSX_SUPABASE_URL "https://atgsesbstjleabesclzs.supabase.co"
  SetEnv ARCUSX_SUPABASE_ANON_KEY "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImF0Z3Nlc2JzdGpsZWFiZXNjbHpzIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjI0NTY3NzgsImV4cCI6MjA3ODAzMjc3OH0.RjwwgXaHHQ-Pz69qeZfXKRc0AuuNdAm3wjecY0xB-YY"

  # Referidos vía PHP (opcional si atribuyes solo desde Edge/cliente)
  # SetEnv ARCUSX_SUPABASE_SERVICE_ROLE_KEY "REEMPLAZA_SERVICE_ROLE"
  # SetEnv REFERRAL_INTERNAL_SECRET "REEMPLAZA"
  # SetEnv REFERRAL_HASH_SALT "REEMPLAZA"
</IfModule>

DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Pasar header Authorization a PHP (CRÍTICO para que PHP reciba el token)
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]
    
    # Permitir métodos DELETE
    RewriteCond %{REQUEST_METHOD} DELETE
    RewriteRule ^api/auth/get_task_details\.php$ - [L]
    
    # Permitir acceso a assets (CSS, JS, imágenes, etc.)
    RewriteCond %{REQUEST_URI} ^/assets/
    RewriteRule . - [L]
    
    # Permitir acceso a archivos estáticos
    RewriteCond %{REQUEST_URI} \.(css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|webp|json|xml|txt)$ [NC]
    RewriteRule . - [L]
    
    # SPA Routing: Redirigir todas las rutas que no sean archivos/directorios a index.html
    # Esto aplica solo para rutas que no empiecen con /api/
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>

