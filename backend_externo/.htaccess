# ArcusX SPA (Vite/React) — copiar este archivo a la raíz de public_html Y a la raíz del subdominio (mismo dist/).
# Si ves 404 en empresas.*: en cPanel → Subdominios → comprobar que la carpeta contiene index.html, assets/ y este .htaccess

DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Pasar header Authorization a PHP (CRÍTICO para que PHP reciba el token)
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]
    
    # Permitir métodos DELETE
    RewriteCond %{REQUEST_METHOD} DELETE
    RewriteRule ^api/auth/get_task_details\.php$ - [L]
    
    # Permitir acceso a assets (CSS, JS, imágenes, etc.)
    RewriteCond %{REQUEST_URI} ^/assets/
    RewriteRule . - [L]
    
    # Permitir acceso a archivos estáticos
    RewriteCond %{REQUEST_URI} \.(css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|webp|json|xml|txt)$ [NC]
    RewriteRule . - [L]
    
    # SPA Routing: Redirigir todas las rutas que no sean archivos/directorios a index.html
    # Esto aplica solo para rutas que no empiecen con /api/
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>

