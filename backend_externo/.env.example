# ArcusX Backend env example
ARCUSX_ENV=development
ARCUSX_DEBUG=1

# DB
ARCUSX_DB_HOST=localhost
ARCUSX_DB_USER=arcusx_user
ARCUSX_DB_PASS=change_me
ARCUSX_DB_NAME=arcusx_db

# JWT
ARCUSX_JWT_SECRET=change_me_super_secret
ARCUSX_JWT_TTL=86400

# Admin (optional)
ARCUSX_ADMIN_EMAIL=admin@example.com
# Generate with PHP: password_hash('your_password', PASSWORD_DEFAULT)
ARCUSX_ADMIN_PASS_HASH=$2y$10$examplehash...

# CORS
ARCUSX_ALLOWED_ORIGINS=http://localhost:5173,https://tudominio.cl

# CSP (optional)
# ARCUSX_CSP=default-src 'self'; ...
