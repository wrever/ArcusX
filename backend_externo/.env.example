# Backend environment variables — ArcusX
# Set these on your server (cPanel: PHP settings → Environment Variables,
# or .htaccess with: SetEnv VARIABLE_NAME value)
# Never commit real values to this file.

# MySQL password for the database user
ARCUSX_DB_PASSWORD=

# Secret key used to sign and verify JWT tokens (use a long random string)
ARCUSX_JWT_SECRET=

# Supabase — URL + al menos ANON (sync OAuth) o SERVICE_ROLE (referidos PHP)
ARCUSX_SUPABASE_URL=
ARCUSX_SUPABASE_ANON_KEY=
ARCUSX_SUPABASE_SERVICE_ROLE_KEY=
REFERRAL_INTERNAL_SECRET=
REFERRAL_HASH_SALT=
REFERRAL_ADMIN_MYSQL_IDS=1
