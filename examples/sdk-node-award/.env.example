# SOW 2 Week 2 — award-style reference (sandbox)
#
# Partner key (required)
ARCUSX_API_KEY=axk_test_…

# Optional — default https://api.arcusx.pro
# ARCUSX_API_URL=https://api.arcusx.pro

# Client (campaign owner) — JWT after OAuth + numeric user id
ARCUSX_CLIENT_JWT=
ARCUSX_CLIENT_USER_ID=

# Worker (applicant / winner) — JWT + user id + Stellar G… wallet
ARCUSX_WORKER_JWT=
ARCUSX_WORKER_USER_ID=
ARCUSX_WORKER_WALLET=G…

# Optional: reuse same Idempotency-Key on a second create (idempotency demo)
# ARCUSX_IDEMPOTENCY_KEY=sow2-w2-award-demo-001

# Optional: skip escrow.createForTask if you only want quote (1 = skip)
# ARCUSX_SKIP_ESCROW_CREATE=0
