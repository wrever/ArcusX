# Partner + optional user JWT for prepare* (user-scoped)
ARCUSX_API_KEY=axk_test_…
# Optional override (default https://api.arcusx.pro)
# ARCUSX_API_URL=

# User-scoped escrow prepare (client who funds)
ARCUSX_USER_JWT=
ARCUSX_CLIENT_WALLET=G…

# Existing task after award/select (Week 2)
ARCUSX_TASK_ID=
ARCUSX_PROPOSAL_ID=

# Quote demo amount
ARCUSX_QUOTE_NOMINAL=50

# 1 = only quote + status (no prepare XDR)
ARCUSX_QUOTE_ONLY=0

# Max status polls (bounded — default 1, never spin forever)
ARCUSX_STATUS_POLLS=1
ARCUSX_STATUS_POLL_MS=2000

# Optional confirm* after you signed/broadcast (Testnet evidence)
# ARCUSX_CONTRACT_ID=C…
# ARCUSX_DEPLOY_TX_HASH=
# ARCUSX_FUND_TX_HASH=
# ARCUSX_RELEASE_TX_HASH=
# ARCUSX_SIGNED_DEPLOY_XDR=
# ARCUSX_SIGNED_FUND_XDR=
